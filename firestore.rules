rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Occupations & live state matrix — public read, admin write
    match /occupations/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // News articles — public read/list, only Cloud Functions / Admin SDK can write
    match /news/{docId} {
      allow read, list: if true;
      allow write: if false; // Admin SDK bypasses these rules
    }

    // Migration news — public read, admin can manage
    match /migration_news/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // In-app notifications feed — backend publishes, admins may remove entries
    match /notifications/{notificationId} {
      allow read, list: if true;
      allow delete: if isAdmin();
      allow create, update: if false;
    }

    // Archived notifications — retained for administrators, never shown publicly
    match /notifications_archived/{notificationId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Draft notifications — authenticated administrators only
    match /notifications_draft/{docId} {
      allow read, list, create, delete, update: if isAdmin();
    }

    // Pending content changes — admin approval queue
    match /pending_content_changes/{docId} {
      allow read, list, delete: if isAdmin();
      allow create, update: if false; // Only backend writes
    }

    // Notification approval/rejection audit trail — admin-only read/list
    match /notification_reviews/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // FCM triggers — admin can read for verification, only backend writes
    match /fcm_triggers/{triggerId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Visa fees — public read, admin can update
    match /visa_fees/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Visa processing times — public read, admin can update
    match /visa_processing_times/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // State nomination status — public read, admin can update
    match /state_nomination_status/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Rules version tracking — public read, admin can update
    match /rules_version/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Scraper metadata — admin only
    match /_scraper_meta/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only backend
    }

    // Scraper runs history — admin only
    match /_scraper_runs/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only backend
    }

    // Scraper heartbeat (last run time/status) — admin dashboard only
    match /system_health/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only backend
    }


    // Migration news items — media articles curated by admin, visible in app.
    // App only ever queries status == 'approved' (utils/newsFeed.ts), so
    // public readers are restricted to approved items; admins see everything
    // (including pending/rejected) for the curation UI.
    match /news_items/{docId} {
      allow read, list: if isAdmin() || resource.data.status == 'approved';
      allow create, update, delete: if isAdmin();
    }

    // Content change history — audit trail of approvals/rejections, admin only
    match /content_change_history/{docId} {
      allow read, list: if isAdmin();
      allow write: if false;                   // Only Cloud Functions write
    }

    // App data (manifest, flags, health) — public read for mobile; admin writes
    match /app_data/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Admin growth drafts (growth agent output) — admin only
    match /admin_growth_drafts/{docId} {
      allow read, list, update, delete: if isAdmin();
      allow create: if false;                  // Only Cloud Functions write
    }

    // Admin feedback (used by growth agent) — admin read
    match /admin_feedback/{docId} {
      allow read, list: if isAdmin();
      allow write: if false;
    }

    // Occupation overrides — admin only (used by publishOccupationsDatabase)
    match /occupation_overrides/{docId} {
      allow read, list, create, update, delete: if isAdmin();
    }

    // Publish history — audit trail of DB publishes, admin only
    match /publish_history/{docId} {
      allow read, list: if isAdmin();
      allow write: if false;
    }

    // Aria chat cache — only Cloud Functions
    match /aria_cache/{docId} {
      allow read, write: if false;
    }

    // Admin intel (competitor site changes) — admin only
    match /admin_intel/{docId} {
      allow read, list, update: if isAdmin();
      allow write: if false;
    }

    match /admin_users/{userId} {
      allow read: if isAdmin() && request.auth.uid == userId;
      allow write: if false;
    }

    // User profiles — authenticated owner only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscriptions — allow read/write (app uses anonymous RevenueCat IDs)
    match /subscriptions/{docId} {
      allow read, write: if true;
    }

    // Watchlists — user-specific. Keyed by the Firebase Auth anonymous uid
    // (see expo-app/utils/firebaseAuth.ts), not the RevenueCat id -- this is
    // what lets us check request.auth.uid == userId here. Before this,
    // `request.auth` was always null (the app never called
    // signInAnonymously()), so ALL watchlist reads/writes were being
    // silently rejected -- and the items subcollection (the actual
    // watchlist entries) had no rule at all, so it was unconditionally
    // denied regardless of auth state.
    match /watchlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
