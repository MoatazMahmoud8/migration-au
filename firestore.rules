rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // News articles — public read/list, only Cloud Functions / Admin SDK can write
    match /news/{docId} {
      allow read, list: if true;
      allow write: if false; // Admin SDK bypasses these rules
    }

    // Migration news — public read, admin can manage
    match /migration_news/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // In-app notifications feed — backend publishes, admins may remove entries
    match /notifications/{notificationId} {
      allow read, list: if true;
      allow delete: if isAdmin();
      allow create, update: if false;
    }

    // Archived notifications — retained for administrators, never shown publicly
    match /notifications_archived/{notificationId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Draft notifications — authenticated administrators only
    match /notifications_draft/{docId} {
      allow read, list, create, delete, update: if isAdmin();
    }

    // Pending content changes — admin approval queue
    match /pending_content_changes/{docId} {
      allow read, list, delete: if isAdmin();
      allow create, update: if false; // Only backend writes
    }

    // Notification approval/rejection audit trail — admin-only read/list
    match /notification_reviews/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // FCM triggers — admin can read for verification, only backend writes
    match /fcm_triggers/{triggerId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // Visa fees — public read, admin can update
    match /visa_fees/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Visa processing times — public read, admin can update
    match /visa_processing_times/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // State nomination status — public read, admin can update
    match /state_nomination_status/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Rules version tracking — public read, admin can update
    match /rules_version/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Scraper metadata — admin only
    match /_scraper_meta/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only backend
    }

    // Scraper runs history — admin only
    match /_scraper_runs/{docId} {
      allow read, list: if isAdmin();
      allow write: if false; // Only backend
    }

    match /admin_users/{userId} {
      allow read: if isAdmin() && request.auth.uid == userId;
      allow write: if false;
    }

    // User profiles — authenticated owner only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscriptions — allow read/write (app uses anonymous RevenueCat IDs)
    match /subscriptions/{docId} {
      allow read, write: if true;
    }

    // Watchlists — user-specific
    match /watchlists/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
